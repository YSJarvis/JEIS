# Where Next.js proxies /api requests (server-side)
API_ORIGIN=http://localhost:8000
# Leave empty to use the proxy; set to call the API directly from the browser
NEXT_PUBLIC_API_BASE=
# Must equal the backend's VOTERENGINE_JWT_SECRET: middleware verifies the session cookie with it
JWT_SECRET=dev-only-insecure-secret-change-me-voterengine-2026
